{
  "name": "portal",
  "version": "0.1.0",
  "description": "社内アプリ統合ポータル（Electron + React + TypeScript）",
  "private": true,
  "volta": {
    "node": "20.18.0"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "author": "internal",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:main": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@img/sharp-win32-x64": "^0.34.5",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@svar-ui/react-gantt": "^2.5.2",
    "better-sqlite3": "^11.3.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "gantt-task-react": "^0.3.9",
    "lucide-react": "^0.453.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.4.168",
    "react": "^18.3.1",
    "react-day-picker": "^9.4.4",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^3.8.0",
    "sharp": "^0.34.4",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "rcedit": "^4.0.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "jp.portal.app",
    "productName": "Portal",
    "afterPack": "./scripts/embed-win-icon.cjs",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "files": [
      "out/**/*",
      "resources/**/*",
      "!resources/tools/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/tools",
        "to": "tools"
      }
    ],
    "win": {
      "icon": "resources/branding/portal/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "resources/branding/portal/icon.ico",
      "uninstallerIcon": "resources/branding/portal/icon.ico"
    }
  }
}
